# ---- Shopify Storefront API (Headless channel) ----
# The store's myshopify domain. Leave the tokens empty to use Shopify's tokenless access
# (products, collections, search and cart work; metafields and higher limits need a token).
SHOPIFY_STORE_DOMAIN=avvvsglobal.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# ---- Customer Account API (Headless channel → Customer Account API) ----
# Public client id. Discovery runs against the store's primary domain.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_DOMAIN=avvvsglobal.com
# 32+ random characters; encrypts the sign-in cookie. e.g. `openssl rand -base64 32`
SESSION_SECRET=

# ---- Shopify webhooks → /api/revalidate?secret=... ----
SHOPIFY_REVALIDATE_SECRET=

# ---- Prescriptions (Vercel Blob) and back-in-stock alerts (Neon) ----
BLOB_READ_WRITE_TOKEN=
DATABASE_URL=

# ---- Mail (pharmacy notifications), same as web/ ----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://shop.avvvs.com
# Free-shipping bar in the cart, in INR. Leave empty to hide it.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
